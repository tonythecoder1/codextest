@model PasswordCenterViewModel

@{
    ViewData["Title"] = "Reposição de passwords";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Segurança</p>
        <h1>Reposição de passwords</h1>
    </div>
</section>

<div class="card-surface">
    <div class="table-scroll">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Colaborador</th>
                    <th>Email</th>
                    <th>Função</th>
                    <th>Estado</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td class="fw-semibold">@employee.FullName</td>
                    <td>@employee.Email</td>
                    <td>@employee.JobTitle</td>
                    <td>
                        <span class="status-pill @(employee.IsActive ? "status-active" : "status-muted")">
                            @(employee.IsActive ? "Ativo" : "Inativo")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="table-actions">
                            <form asp-action="SendPasswordReset" asp-route-id="@employee.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-primary" @(employee.IsActive ? null : "disabled")>Enviar email</button>
                            </form>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="ChangePassword" asp-route-id="@employee.Id">Alterar</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
