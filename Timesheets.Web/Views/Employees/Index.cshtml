@model IReadOnlyList<Employee>

@{
    ViewData["Title"] = "Colaboradores";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Equipa</p>
        <h1>Colaboradores</h1>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="PasswordCenter">Reposição</a>
        <a class="btn btn-primary" asp-action="Create">Novo colaborador</a>
    </div>
</section>

<div class="card-surface">
    <div class="table-scroll">
    <table class="table app-table align-middle mb-0">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Função</th>
                <th>Email</th>
                <th>Perfil</th>
                <th>Responsável</th>
                <th>Estado</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td class="fw-semibold">@employee.FullName</td>
                <td>@employee.JobTitle</td>
                <td>@employee.Email</td>
                <td>
                    <span class="status-pill @(employee.IsAdmin ? "status-admin" : employee.IsManager ? "status-pending" : "status-muted")">
                        @(employee.IsAdmin ? "Admin" : employee.IsManager ? "Responsável" : "Colaborador")
                    </span>
                </td>
                <td>@(employee.Responsible?.FullName ?? "—")</td>
                <td>
                    <span class="status-pill @(employee.IsActive ? "status-active" : "status-muted")">
                        @(employee.IsActive ? "Ativo" : "Inativo")
                    </span>
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@employee.Id">Editar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
