@model TimesheetEntryFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    @if (Model.CanChooseEmployee)
    {
        <div class="col-md-6">
            <label asp-for="EmployeeId" class="form-label"></label>
            <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                <option value="">Seleciona um colaborador</option>
            </select>
            <span asp-validation-for="EmployeeId" class="text-danger"></span>
        </div>
    }
    else
    {
        <input asp-for="EmployeeId" type="hidden" />
    }
    <div class="col-md-6">
        <label asp-for="EntryType" class="form-label"></label>
        <select asp-for="EntryType" asp-items="Model.EntryTypes" class="form-select" data-entry-type-select></select>
        <span asp-validation-for="EntryType" class="text-danger"></span>
    </div>
    <div class="col-md-6" data-project-field>
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
            <option value="">Seleciona um projeto</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    @if (Model.Id.HasValue)
    {
        <div class="col-md-6">
            <label asp-for="WorkDate" class="form-label"></label>
            <input asp-for="WorkDate" class="form-control" type="date" />
            <span asp-validation-for="WorkDate" class="text-danger"></span>
        </div>
    }
    else
    {
        <input asp-for="WorkDate" type="hidden" />
        <div class="col-12">
            <label asp-for="SelectedDates" class="form-label"></label>
            <input asp-for="SelectedDates" type="hidden" id="selectedDatesInput" />
            <div class="calendar-picker" data-selected-dates="@Model.SelectedDates">
                <div class="calendar-toolbar">
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-calendar-prev>Anterior</button>
                    <strong data-calendar-title></strong>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-calendar-next>Seguinte</button>
                </div>
                <div class="calendar-weekdays">
                    <span>Seg</span>
                    <span>Ter</span>
                    <span>Qua</span>
                    <span>Qui</span>
                    <span>Sex</span>
                    <span>Sáb</span>
                    <span>Dom</span>
                </div>
                <div class="calendar-days" data-calendar-days></div>
            </div>
            <span asp-validation-for="SelectedDates" class="text-danger"></span>
        </div>
    }
    <div class="col-md-6">
        <label asp-for="Hours" class="form-label"></label>
        <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0.25" max="12" />
        <span asp-validation-for="Hours" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-check mt-2">
            <input asp-for="IsBillable" class="form-check-input" />
            <label asp-for="IsBillable" class="form-check-label"></label>
        </div>
    </div>
</div>

<script>
    (() => {
        const typeSelect = document.querySelector("[data-entry-type-select]");
        const projectField = document.querySelector("[data-project-field]");
        const projectSelect = projectField?.querySelector("select");
        const billableInput = document.getElementById("IsBillable");

        if (!typeSelect || !projectField || !projectSelect || !billableInput) {
            return;
        }

        const syncEntryTypeState = () => {
            const isWork = typeSelect.value === "Work";
            projectField.hidden = !isWork;

            if (!isWork) {
                projectSelect.value = "";
                billableInput.checked = false;
                billableInput.disabled = true;
            } else {
                billableInput.disabled = false;
            }
        };

        typeSelect.addEventListener("change", syncEntryTypeState);
        syncEntryTypeState();
    })();
</script>
