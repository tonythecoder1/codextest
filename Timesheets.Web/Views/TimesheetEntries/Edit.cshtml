@model TimesheetEntryFormViewModel

@{
    ViewData["Title"] = "Editar registo";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Operação</p>
        <h1>Editar registo de horas</h1>
    </div>
</section>

<div class="card-surface form-shell">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary simple-action-button">Guardar alterações</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
