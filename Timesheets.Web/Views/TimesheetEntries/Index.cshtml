@using System.Text.Json
@model TimesheetEntriesIndexViewModel

@{
    ViewData["Title"] = "Registos de horas";
    var pdfMonthLookupJson = JsonSerializer.Serialize(Model.PdfMonthLookup);
}

<section class="page-header">
    <div class="page-header-copy">
        <p class="eyebrow">Operação</p>
        <h1>@(Model.CanChooseEmployee ? "Registos de horas" : "As minhas horas")</h1>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary simple-action-button" asp-action="Create">Novo registo</a>
    </div>
</section>

<section class="control-grid">
    <div class="card-surface filter-shell">
        <div class="compact-card-heading">
            <div>
                <p class="eyebrow">Filtro</p>
                <h2>Filtros</h2>
            </div>
        </div>

        <form method="get" class="filter-grid">
            @if (Model.CanChooseEmployee)
            {
                <div class="filter-field">
                    <label class="form-label" asp-for="EmployeeId">Colaborador</label>
                    <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>
            }
            else
            {
                <input asp-for="EmployeeId" type="hidden" />
            }
            <div class="filter-field">
                <label class="form-label" asp-for="ProjectId">Projeto</label>
                <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="filter-field">
                <label class="form-label" asp-for="FromDate">De</label>
                <input asp-for="FromDate" class="form-control" type="date" />
            </div>
            <div class="filter-field">
                <label class="form-label" asp-for="ToDate">Até</label>
                <input asp-for="ToDate" class="form-control" type="date" />
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>
    </div>

    <section class="card-surface export-shell">
        <div class="compact-card-heading">
            <div>
                <p class="eyebrow">Exportação</p>
                <h2>PDFs</h2>
            </div>
        </div>

        <div class="export-grid">
            <form method="get" asp-action="MonthlyPdf" class="export-form">
                @if (Model.CanChoosePdfEmployee)
                {
                    <div class="export-field">
                        <label class="form-label" for="pdfEmployeeId">Colaborador</label>
                        <select id="pdfEmployeeId" name="employeeId" class="form-select" data-pdf-employee-select>
                            @foreach (var employee in Model.PdfEmployees)
                            {
                                <option value="@employee.Value" selected="@(employee.Value == Model.PdfEmployeeId?.ToString() ? "selected" : null)">@employee.Text</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="employeeId" value="@Model.PdfEmployeeId" />
                }

                <div class="export-field">
                    <label class="form-label" for="month">Mês completo</label>
                    <select id="month" name="month" class="form-select" data-pdf-month-select @(Model.CanGenerateMonthlyPdf ? null : "disabled")>
                        @if (Model.CompletedMonths.Count == 0)
                        {
                            <option value="">Sem meses disponíveis</option>
                        }
                        else
                        {
                            @foreach (var month in Model.CompletedMonths)
                            {
                                <option value="@month.Value" selected="@(month.Value == Model.SelectedMonth ? "selected" : null)">@month.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="export-actions export-actions-stack">
                    <button type="submit" class="btn btn-primary simple-action-button" data-pdf-submit @(Model.CanGenerateMonthlyPdf ? null : "disabled")>PDF mensal</button>
                    <a class="btn btn-outline-secondary simple-action-button" asp-action="ReportPdf" asp-route-employeeId="@Model.EmployeeId" asp-route-projectId="@Model.ProjectId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">PDF relatório</a>
                </div>
            </form>
        </div>
    </section>
</section>

<section class="stats-grid compact-stats">
    <article class="stat-card">
        <span class="stat-label">Total de horas</span>
        <strong>@Model.TotalHours.ToString("0.##")h</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Registos encontrados</span>
        <strong>@Model.EntryCount</strong>
    </article>
</section>

@if (Model.PendingApprovalEntries.Count > 0)
{
    <section class="approval-queue-shell">
        <div class="approval-queue-header">
            <div>
                <p class="eyebrow">Aprovação</p>
                <h2>Horas pendentes</h2>
            </div>
            <span class="status-pill status-pending">@Model.PendingApprovalEntries.Count pendente@(Model.PendingApprovalEntries.Count == 1 ? "" : "s")</span>
        </div>

        <div class="approval-queue-list">
            @foreach (var entry in Model.PendingApprovalEntries)
            {
                <article class="approval-queue-item">
                    <div class="approval-queue-main">
                        <span class="project-dot" style="background:@entry.ProjectColorHex"></span>
                        <div>
                            <strong>@entry.EmployeeName</strong>
                            <p>@entry.ProjectName · @entry.WorkDate.ToString("dd/MM/yyyy") · @entry.Hours.ToString("0.##")h</p>
                            <p>@entry.Description</p>
                        </div>
                    </div>
                    <form asp-action="Approve" asp-route-id="@entry.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-primary btn-sm approval-action-button">Aprovar horas</button>
                    </form>
                </article>
            }
        </div>
    </section>
}

<div class="card-surface">
    <div class="table-scroll">
    @if (Model.Entries.Count == 0)
    {
        <p class="empty-state mb-0">Não existem registos com estes filtros.</p>
    }
    else
    {
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Data</th>
                    @if (Model.CanChooseEmployee)
                    {
                        <th>Colaborador</th>
                    }
                    <th>Projeto</th>
                    <th>Descrição</th>
                    <th>Horas</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.WorkDate.ToString("dd/MM/yyyy")</td>
                    @if (Model.CanChooseEmployee)
                    {
                        <td class="fw-semibold">@entry.EmployeeName</td>
                    }
                    <td>
                        <span class="project-dot" style="background:@entry.ProjectColorHex"></span>
                        @entry.ProjectName
                    </td>
                    <td>@entry.Description</td>
                    <td>@entry.Hours.ToString("0.##")h</td>
                    <td>
                        <span class="status-pill @(entry.EntryType switch { TimesheetEntryType.Work => (entry.IsBillable ? "status-active" : "status-muted"), TimesheetEntryType.Vacation => "status-vacation", _ => "status-admin" })">
                            @entry.EntryType.ToDisplayName()
                        </span>
                    </td>
                    <td>
                        <span class="status-pill @(entry.ApprovalStatus == TimesheetApprovalStatus.Approved ? "status-active" : "status-pending")">
                            @entry.ApprovalStatus.ToDisplayName()
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="table-actions">
                            @if (entry.CanApprove)
                            {
                                <form asp-action="Approve" asp-route-id="@entry.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                    <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="btn btn-sm btn-primary">Aprovar</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@entry.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@entry.Id" method="post" onsubmit="return confirm('Remover este registo?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Apagar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const lookup = @Html.Raw(pdfMonthLookupJson);
            const employeeSelect = document.querySelector('[data-pdf-employee-select]');
            const monthSelect = document.querySelector('[data-pdf-month-select]');
            const submitButton = document.querySelector('[data-pdf-submit]');
            const selectedMonth = '@Model.SelectedMonth';
            const canChoosePdfEmployee = @(Model.CanChoosePdfEmployee ? "true" : "false");

            if (!monthSelect || !submitButton || !canChoosePdfEmployee) {
                return;
            }

            const noMonthsLabel = 'Sem meses disponíveis';

            const renderMonths = () => {
                const employeeId = employeeSelect?.value ?? '';
                const months = lookup.find(item => String(item.EmployeeId) === employeeId)?.Months ?? [];
                const preferredValue = monthSelect.value || selectedMonth;

                monthSelect.innerHTML = '';

                if (months.length === 0) {
                    monthSelect.append(new Option(noMonthsLabel, ''));
                    monthSelect.disabled = true;
                    submitButton.disabled = true;
                } else {
                    months.forEach((month, index) => {
                        const option = new Option(month.Text, month.Value, false, month.Value === preferredValue || (!preferredValue && index === 0));
                        monthSelect.append(option);
                    });

                    monthSelect.disabled = false;
                    submitButton.disabled = false;
                }
            };

            employeeSelect?.addEventListener('change', renderMonths);
            renderMonths();
        })();
    </script>
}
