@model TimesheetEntriesIndexViewModel

@{
    ViewData["Title"] = "Registos de horas";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Operação</p>
        <h1>@(Model.CanChooseEmployee ? "Registos de horas" : "As minhas horas")</h1>
        <p class="page-intro">@(Model.CanChooseEmployee
            ? "Filtra rapidamente por colaborador, projeto ou período para analisar o trabalho da equipa."
            : "Consulta os teus registos por projeto e período.")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary simple-action-button" asp-action="Create">Novo registo</a>
        <a class="btn btn-outline-secondary" asp-action="ReportPdf" asp-route-employeeId="@Model.EmployeeId" asp-route-projectId="@Model.ProjectId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">PDF relatório</a>
    </div>
</section>

<div class="card-surface filter-shell">
    <form method="get" class="row g-3 align-items-end">
        @if (Model.CanChooseEmployee)
        {
            <div class="col-md-3">
                <label class="form-label" asp-for="EmployeeId">Colaborador</label>
                <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
        }
        else
        {
            <input asp-for="EmployeeId" type="hidden" />
        }
        <div class="col-md-3">
            <label class="form-label" asp-for="ProjectId">Projeto</label>
            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" asp-for="FromDate">De</label>
            <input asp-for="FromDate" class="form-control" type="date" />
        </div>
        <div class="col-md-2">
            <label class="form-label" asp-for="ToDate">Até</label>
            <input asp-for="ToDate" class="form-control" type="date" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>
</div>

<div class="card-surface filter-shell">
    <form method="get" asp-action="MonthlyPdf" class="row g-3 align-items-end">
        @if (Model.CanChooseEmployee)
        {
            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
        }
        <div class="col-md-4">
            <label class="form-label" for="month">Mês completo</label>
            <select id="month" name="month" class="form-select" @(Model.CanGenerateMonthlyPdf ? null : "disabled")>
                @if (Model.CompletedMonths.Count == 0)
                {
                    <option value="">Sem meses disponíveis</option>
                }
                else
                {
                    @foreach (var month in Model.CompletedMonths)
                    {
                        <option value="@month.Value" selected="@(month.Value == Model.SelectedMonth ? "selected" : null)">@month.Text</option>
                    }
                }
            </select>
            <p class="form-hint">@Model.MonthlyPdfHelpText</p>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100" @(Model.CanGenerateMonthlyPdf ? null : "disabled")>PDF mensal</button>
        </div>
    </form>
</div>

<section class="stats-grid compact-stats">
    <article class="stat-card">
        <span class="stat-label">Total de horas</span>
        <strong>@Model.TotalHours.ToString("0.##")h</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Registos encontrados</span>
        <strong>@Model.EntryCount</strong>
    </article>
</section>

<div class="card-surface">
    @if (Model.Entries.Count == 0)
    {
        <p class="empty-state mb-0">Não existem registos com estes filtros.</p>
    }
    else
    {
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Data</th>
                    @if (Model.CanChooseEmployee)
                    {
                        <th>Colaborador</th>
                    }
                    <th>Projeto</th>
                    <th>Descrição</th>
                    <th>Horas</th>
                    <th>Tipo</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.WorkDate.ToString("dd/MM/yyyy")</td>
                    @if (Model.CanChooseEmployee)
                    {
                        <td class="fw-semibold">@entry.EmployeeName</td>
                    }
                    <td>
                        <span class="project-dot" style="background:@entry.ProjectColorHex"></span>
                        @entry.ProjectName
                    </td>
                    <td>@entry.Description</td>
                    <td>@entry.Hours.ToString("0.##")h</td>
                    <td>
                        <span class="status-pill @(entry.EntryType switch { TimesheetEntryType.Work => (entry.IsBillable ? "status-active" : "status-muted"), TimesheetEntryType.Vacation => "status-vacation", _ => "status-admin" })">
                            @entry.EntryType.ToDisplayName()
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@entry.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@entry.Id" method="post" onsubmit="return confirm('Remover este registo?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Apagar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
