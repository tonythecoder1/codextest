<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAVANA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg py-3">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">SV</span>
                    <span class="brand-copy">
                        <strong>SAVANA</strong>
                        <small>BY HUMANS FOR HUMANS</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TimesheetEntries" asp-action="Index">Horas</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Employees" asp-action="Index">Colaboradores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="Index">Projetos</a>
                                </li>
                            }
                        </ul>
                        <div class="nav-user">
                            <span>@User.Identity.Name</span>
                            <a class="btn btn-primary btn-sm simple-action-button" asp-controller="TimesheetEntries" asp-action="Create">Novo registo</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </header>

    <div class="container app-shell">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success app-alert" role="alert">@statusMessage</div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container footer-content">
            <span><strong>SAVANA</strong> · BY HUMANS FOR HUMANS</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
