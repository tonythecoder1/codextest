@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Timesheets.Web.Data
@inject AppDbContext LayoutDbContext

@{
    var headerNotifications = new List<AppNotification>();
    var headerUnreadCount = 0;

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var headerEmployeeId))
    {
        headerUnreadCount = await LayoutDbContext.AppNotifications
            .AsNoTracking()
            .CountAsync(notification => notification.EmployeeId == headerEmployeeId && notification.ReadAt == null);

        headerNotifications = await LayoutDbContext.AppNotifications
            .AsNoTracking()
            .Where(notification => notification.EmployeeId == headerEmployeeId)
            .OrderByDescending(notification => notification.CreatedAt)
            .Take(6)
            .ToListAsync();
    }
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg py-3">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/branding/timeflow-logo.svg" alt="TimeFlow by Savana" class="app-brand-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TimesheetEntries" asp-action="Index">Horas</a>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Employees" asp-action="Index">Colaboradores</a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="Index">Projetos</a>
                                </li>
                            }
                        </ul>
                        <div class="nav-user">
                            <div class="dropdown notification-dropdown">
                                <button class="notification-trigger" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                        aria-expanded="false" aria-label="Notificações">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 3.5a5.5 5.5 0 0 0-5.5 5.5v2.45c0 .78-.25 1.54-.72 2.16l-.9 1.2a1.25 1.25 0 0 0 1 2h12.24a1.25 1.25 0 0 0 1-2l-.9-1.2a3.5 3.5 0 0 1-.72-2.16V9A5.5 5.5 0 0 0 12 3.5Z" />
                                        <path d="M9.65 18.35a2.5 2.5 0 0 0 4.7 0" />
                                    </svg>
                                    @if (headerUnreadCount > 0)
                                    {
                                        <span class="notification-badge" data-notification-badge>@Math.Min(headerUnreadCount, 9)</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end notification-menu">
                                    <form class="notification-token-form d-none">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <div class="notification-menu-header">
                                        <div>
                                            <strong>Notificações</strong>
                                            <span>@headerUnreadCount por ler</span>
                                        </div>
                                        @if (headerUnreadCount > 0)
                                        {
                                            <button type="button" class="notification-mark-all" data-notification-mark-all-url="@Url.Action("MarkAllRead", "Notifications")">
                                                Marcar lidas
                                            </button>
                                        }
                                    </div>
                                    <div class="notification-menu-list">
                                        @if (headerNotifications.Count == 0)
                                        {
                                            <div class="notification-empty">Sem notificações.</div>
                                        }
                                        else
                                        {
                                            @foreach (var notification in headerNotifications)
                                            {
                                                var notificationPreview = notification.Message.Replace("\r", " ").Replace("\n", " ");
                                                if (notificationPreview.Length > 118)
                                                {
                                                    notificationPreview = $"{notificationPreview[..115]}...";
                                                }

                                                <article class="notification-menu-item @(notification.ReadAt is null ? "is-unread" : "")">
                                                    <div>
                                                        <strong>@notification.Title</strong>
                                                        <p>@notificationPreview</p>
                                                        <small>@notification.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                                    </div>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary notification-open-button"
                                                            data-notification-read-url="@Url.Action("MarkRead", "Notifications", new { id = notification.Id })"
                                                            data-notification-target-url="@notification.Url">
                                                        @(string.IsNullOrWhiteSpace(notification.Url) ? "Lida" : "Abrir")
                                                    </button>
                                                </article>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <span>@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </header>

    <div class="container app-shell">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success app-alert" role="alert">@statusMessage</div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container footer-content">
            <span class="footer-company-mark" aria-label="Savana">
                <img src="~/branding/savana-company.jpeg" alt="Savana" class="footer-company-logo" />
            </span>
            <span>@DateTime.Now.Year</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
