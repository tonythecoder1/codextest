@model Project

@{
    ViewData["Title"] = "Editar projeto";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Portefólio</p>
        <h1>Editar projeto</h1>
        <p class="page-intro">Mantém nomes, cliente e cor alinhados com o teu contexto de trabalho.</p>
    </div>
</section>

<div class="card-surface form-shell">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar alterações</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
